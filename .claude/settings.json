{
  "permissions": {
    "allow": [
      "Bash(git*)",
      "Bash(gh*)",
      "Bash(docker*)",
      "Bash(exegol*)",
      "Bash(pipx*)",
      "Bash(brew*)",
      "Bash(cd*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(echo*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(chmod*)",
      "Bash(wc*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(sed*)",
      "Bash(awk*)",
      "Bash(rg*)",
      "Bash(cut*)",
      "Bash(tr*)",
      "Bash(nl*)",
      "Bash(diff*)",
      "Bash(comm*)",
      "Bash(which*)",
      "Bash(test*)",
      "Bash(basename*)",
      "Bash(dirname*)",
      "Bash(realpath*)",
      "Bash(stat*)",
      "Bash(date*)",
      "Bash(printf*)",
      "Bash(tee*)",
      "Bash(jq*)",
      "Bash(touch*)",
      "Bash(less*)",
      "Bash(tree*)",
      "Bash(du*)",
      "Bash(open*)",
      "Bash(pbcopy*)",
      "Bash(pbpaste*)",
      "Bash(bash cleanup.sh*)",
      "Bash(bash challenges/*)",
      "Bash(python3 tools/*)",
      "Bash(python3 ~/.claude/ctf/*)",
      "Bash(./install.sh*)",
      "Bash(docker exec exegol-ctf-*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/enforce_exegol.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-git",
        "--repository",
        "."
      ]
    }
  }
}
